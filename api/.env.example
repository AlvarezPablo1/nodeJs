# Copiá este archivo como .env y completá los valores reales.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?schema=public
# Estos valores coinciden con la base local de compose.yaml (solo para desarrollo).
DATABASE_URL="postgresql://turnero:turnero@localhost:5432/turnero?schema=public"

# Clave para firmar los JWT: mínimo 32 caracteres. Generá una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiame-por-una-clave-larga-y-aleatoria-de-32-o-mas"
# Cuánto dura una sesión, en segundos (28800 = 8 horas)
JWT_EXPIRA_EN_SEGUNDOS=28800
