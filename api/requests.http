@baseUrl = http://localhost:3000/api/v1
@idLaura = 11111111-1111-4111-8111-111111111111
@idMartin = 22222222-2222-4222-8222-222222222222
@idCarlos = aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
@idLucia = bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
@idInexistente = 99999999-9999-4999-8999-999999999999

# =========================================================
# ===== Utilidades (funcionan cuando termines el ejercicio 1)
# =========================================================

### Health check
GET {{baseUrl}}/health

### Info
GET {{baseUrl}}/info

### Saludo informal
GET {{baseUrl}}/greeting/Pablo

### Saludo formal
GET {{baseUrl}}/greeting/Pablo?formal=true

### Saludo con formal=false explícito
GET {{baseUrl}}/greeting/Pablo?formal=false

### Saludo con formal inválido → 400
GET {{baseUrl}}/greeting/Pablo?formal=si

# =========================================================
# ===== Profesionales · Lectura
# =========================================================

### Listar todos
GET {{baseUrl}}/profesionales

### Filtrar por especialidad
GET {{baseUrl}}/profesionales?especialidad=Nutrición

### Filtrar por especialidad sin resultados → 200 con []
GET {{baseUrl}}/profesionales?especialidad=Odontología

### Ver uno
GET {{baseUrl}}/profesionales/{{idLaura}}

### Ver uno con UUID válido que no existe → 404
GET {{baseUrl}}/profesionales/{{idInexistente}}

### Ver uno con id mal formado → 400
GET {{baseUrl}}/profesionales/hola

# =========================================================
# ===== Profesionales · Flujo completo (ejecutar en orden)
# =========================================================

### 1. Crear profesional
# @name crear
POST {{baseUrl}}/profesionales
Content-Type: application/json

{
  "nombre": "Ana Torres",
  "especialidad": "Psicología",
  "email": "ana@turnero.com"
}

### 2. Ver el recién creado
GET {{baseUrl}}/profesionales/{{crear.response.body.response.data.id}}

### 3. Actualizar el recién creado
PUT {{baseUrl}}/profesionales/{{crear.response.body.response.data.id}}
Content-Type: application/json

{
  "nombre": "Ana Torres",
  "especialidad": "Psicología Infantil",
  "email": "ana.torres@turnero.com"
}

### 4. Eliminar el recién creado → 200, data null
DELETE {{baseUrl}}/profesionales/{{crear.response.body.response.data.id}}

### 5. Verlo después de eliminado → 404
GET {{baseUrl}}/profesionales/{{crear.response.body.response.data.id}}

# =========================================================
# ===== Profesionales · Validaciones (todas → 400)
# =========================================================

### Crear con datos incompletos
POST {{baseUrl}}/profesionales
Content-Type: application/json

{
  "nombre": "Sin especialidad"
}

### Crear con email mal formado
POST {{baseUrl}}/profesionales
Content-Type: application/json

{
  "nombre": "Juan Díaz",
  "especialidad": "Traumatología",
  "email": "esto-no-es-un-email"
}

### Crear con nombre de una letra
POST {{baseUrl}}/profesionales
Content-Type: application/json

{
  "nombre": "J",
  "especialidad": "Traumatología",
  "email": "juan@turnero.com"
}

### Crear con nombre solo espacios
POST {{baseUrl}}/profesionales
Content-Type: application/json

{
  "nombre": "   ",
  "especialidad": "Traumatología",
  "email": "juan@turnero.com"
}

### Crear con JSON mal formado (coma de más a propósito)
POST {{baseUrl}}/profesionales
Content-Type: application/json

{
  "nombre": "Juan Díaz",
  "especialidad": "Traumatología",
  "email": "juan@turnero.com",
}

### Actualizar con id mal formado
PUT {{baseUrl}}/profesionales/hola
Content-Type: application/json

{
  "nombre": "Laura Gómez",
  "especialidad": "Kinesiología",
  "email": "laura@turnero.com"
}

# =========================================================
# ===== Profesionales · Otros casos
# =========================================================

### Crear con campo extra → 201, pero esAdmin NO debe aparecer en la respuesta
POST {{baseUrl}}/profesionales
Content-Type: application/json

{
  "nombre": "Ana López",
  "especialidad": "Dermatología",
  "email": "ana@turnero.com",
  "esAdmin": true
}

### Actualizar uno que no existe → 404
PUT {{baseUrl}}/profesionales/{{idInexistente}}
Content-Type: application/json

{
  "nombre": "Nadie",
  "especialidad": "Ninguna",
  "email": "nadie@turnero.com"
}

### Eliminar uno que no existe → 404
DELETE {{baseUrl}}/profesionales/{{idInexistente}}

# =========================================================
# ===== Turnos
# =========================================================

### Listar turnos (primera página)
GET {{baseUrl}}/turnos

### Listar turnos ordenados por inicio descendente
GET {{baseUrl}}/turnos?orden=-inicio 

### Paginación: de a 1 por página, segunda página
GET {{baseUrl}}/turnos?porPagina=1&pagina=2

### Filtrar por profesional y estado
GET {{baseUrl}}/turnos?profesionalId={{idLaura}}&estado=confirmado

### Rango de fechas invertido → 400
GET {{baseUrl}}/turnos?desde=2026-12-01T00:00:00-03:00&hasta=2026-11-01T00:00:00-03:00

### porPagina excesivo → 400
GET {{baseUrl}}/turnos?porPagina=1000

# ===== Disponibilidad (cambiá la fecha por mañana, en día hábil)

### Disponibilidad de Laura en bloques de 45 minutos
GET {{baseUrl}}/profesionales/{{idLaura}}/disponibilidad?fecha=2026-10-16&duracion=45

### Laura un domingo → result false, data.atiende false y horarios vacío
GET {{baseUrl}}/profesionales/{{idLaura}}/disponibilidad?fecha=2026-10-18

### Fecha mal formada → 400
GET {{baseUrl}}/profesionales/{{idLaura}}/disponibilidad?fecha=16/10/2026

### Reservar turno libre → 201
POST {{baseUrl}}/turnos
Content-Type: application/json

{
  "profesionalId": "{{idLaura}}",
  "clienteId": "{{idCarlos}}",
  "inicio": "2026-10-20T12:00:00-03:00",
  "duracion": 30
}

### Reservar encima de un turno existente → 200, result false, HORARIO_OCUPADO
POST {{baseUrl}}/turnos
Content-Type: application/json

{
  "profesionalId": "{{idLaura}}",
  "clienteId": "{{idLucia}}",
  "inicio": "2026-10-20T10:30:00-03:00",
  "duracion": 30
}

### Fuera de horario (Laura atiende hasta las 13) → 200, result false, FUERA_DE_HORARIO
POST {{baseUrl}}/turnos
Content-Type: application/json

{
  "profesionalId": "{{idLaura}}",
  "clienteId": "{{idCarlos}}",
  "inicio": "2026-10-20T12:45:00-03:00",
  "duracion": 30
}

### En el pasado → 200, result false, TURNO_EN_EL_PASADO
POST {{baseUrl}}/turnos
Content-Type: application/json

{
  "profesionalId": "{{idLaura}}",
  "clienteId": "{{idCarlos}}",
  "inicio": "2026-01-05T10:00:00-03:00",
  "duracion": 30
}

### Fecha sin zona horaria → 400
POST {{baseUrl}}/turnos
Content-Type: application/json

{
  "profesionalId": "{{idLaura}}",
  "clienteId": "{{idCarlos}}",
  "inicio": "2026-10-20T12:00:00",
  "duracion": 30
}

### Duración que no es múltiplo de 15 → 400
POST {{baseUrl}}/turnos
Content-Type: application/json

{
  "profesionalId": "{{idLaura}}",
  "clienteId": "{{idCarlos}}",
  "inicio": "2026-10-20T12:00:00-03:00",
  "duracion": 20
}

### Cliente inexistente → 404
POST {{baseUrl}}/turnos
Content-Type: application/json

{
  "profesionalId": "{{idLaura}}",
  "clienteId": "{{idInexistente}}",
  "inicio": "2026-10-20T12:00:00-03:00",
  "duracion": 30
}

